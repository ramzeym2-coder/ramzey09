# =========================================================
# PULSING SKULL
# =========================================================

skull = canvas.create_text(
    375,
    190,
    text="☠",
    fill="#cc0000",
    font=("Arial", 120, "bold")
)

skull_size = 120
skull_direction = 1


def skull_pulse():

    global skull_size
    global skull_direction

    if revealed:
        return

    skull_size += skull_direction * 2

    if skull_size >= 145:
        skull_direction = -1

    if skull_size <= 115:
        skull_direction = 1

    canvas.itemconfig(
        skull,
        font=("Arial", skull_size, "bold")
    )

    root.after(
        45,
        skull_pulse
    )


