# =========================================================
# FLOATING HEARTS
# =========================================================

def spawn_heart():

    if not revealed:
        return

    x = random.randint(
        20,
        730
    )

    heart = canvas.create_text(
        x,
        520,
        text=random.choice([
            "💗",
            "💕",
            "💖",
            "💘",
            "❤️"
        ]),
        font=(
            "Arial",
            random.randint(15, 28)
        )
    )

    def move(y=520):

        if y < -30:
            canvas.delete(heart)
            return

        canvas.move(
            heart,
            0,
            -2
        )

        root.after(
            25,
            lambda: move(y - 2)
        )

    move()

    root.after(
        random.randint(150, 450),
        spawn_heart
    )


