    anchor="nw",
    text="",
    fill="#550000",
    font=("Consolas", 10)
)


def terminal_animation(index=0):

    if revealed:
        return

    if index < len(terminal_lines):

        old_text = canvas.itemcget(
            terminal,
            "text"
        )

        canvas.itemconfig(
            terminal,
            text=old_text + "\n> " + terminal_lines[index]
        )

        root.after(
            random.randint(250, 650),
            lambda: terminal_animation(index + 1)
        )


